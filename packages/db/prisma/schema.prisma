generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  email        String        @unique
  password     String
  workspace    Workspace?
}

model Workspace {
  id      String @id @default(uuid())
  name    String
  website String
  user    User   @relation(fields: [userId], references: [id])
  userId  String @unique
}
