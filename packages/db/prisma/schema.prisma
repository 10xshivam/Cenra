generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  email     String     @unique
  password  String
  workspace Workspace?
}

model Workspace {
  id             String          @id @default(uuid())
  name           String
  website        String?
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  resources      Resource[]
  customers      Customer[]
  conversations  Conversation[]
  widgetSettings WidgetSettings?
}

model Resource {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  sourceType  ResourceSourceType
  url         String?
  paths       String[]           @default([])
  filename    String?
  mimeType    String?
  fileText    String?
  webContent  Json?
  active      Boolean            @default(true)
  updatedAt   DateTime           @default(now())
  createdAt   DateTime           @default(now())
}

enum ResourceSourceType {
  WEB
  FILE
}

model Customer {
  id            String         @id @default(uuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  name          String?
  email         String?
  conversations Conversation[]
  metadata      Json?
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
}

enum ConversationStatus {
  unresolved
  escalated
  resolved
}

model Conversation {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])
  threadId    String             @unique
  status      ConversationStatus @default(unresolved)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model WidgetSettings {
  id                 String    @id @default(uuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  greetMessage       String    @default("Hi! How can I help you today?")
  defaultSuggestions Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId])
}
